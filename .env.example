# Copy to .env and fill in. .env is gitignored.

# Base URL of the RunPod pod running idm-vton + catvton
# (set after runpod/server.py starts, e.g. https://<pod-id>-8000.proxy.runpod.net)
RUNPOD_TRYON_URL=
RUNPOD_GPU_HOURLY_USD=0.74

# Base URL of the Leffa server (runpod/leffa_server.py in venv_leffa). Optional.
RUNPOD_LEFFA_URL=

# fal.ai key - only needed to test the hosted models (FLUX Pro VTO, image-apps-v2)
FAL_KEY=
